# === LLM (chat) ============================================================
# Provider: openai | ollama | google | anthropic
LLM_PROVIDER=openai
# OpenAI-compatible base URL (leave blank for official OpenAI)
OPENAI_API_BASE=
# For CLI / index build. The Streamlit UI can also accept the key at login time.
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Embeddings ============================================================
# Provider: openai | huggingface | ollama
# Recommended default for demos: huggingface (local, free). Use openai if preferred.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=text-embedding-3-small
# HuggingFace local model (if EMBEDDING_PROVIDER=huggingface)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# === Vector store ==========================================================
VECTOR_STORE_PATH=data/vector_store
VECTOR_STORE_COLLECTION=pearlz_kb
# Distance: cosine | l2 | ip
VECTOR_STORE_DISTANCE=cosine

# === Chunking ==============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# recursive | markdown | csv_row
CHUNK_STRATEGY=hybrid

# === Retrieval =============================================================
RETRIEVAL_K=4
RETRIEVAL_STRATEGY=mmr
# MMR diversity 0..1 (higher = more diverse)
MMR_LAMBDA=0.5
# Minimum similarity (0..1). Calibrate on your index; Chroma cosine similarity.
SCORE_THRESHOLD=0.35
# Cap context injected into the prompt
MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_CHUNKS=4

# === Conversation ==========================================================
HISTORY_WINDOW_TURNS=6
SUPPORT_ESCALATION_EMAIL=support@pearlzhome.example

# === Paths & logging =======================================================
KNOWLEDGE_BASE_PATH=data/knowledge_base
LOG_LEVEL=INFO
LOG_FILE=logs/supportpearlz.log
SESSION_LOG_DIR=logs/sessions
